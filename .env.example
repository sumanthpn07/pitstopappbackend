# --- Database ---
# Matches docker-compose.yml (host port 5434). Change if you point at your own
# Postgres, or set DB_PORT to remap the docker container's host port.
DATABASE_URL="postgresql://pitstop:pitstop@localhost:5434/pitstop?schema=public"

# --- Server ---
PORT=4000
# Comma-separated allowed origins for CORS. "*" allows any (fine for local dev).
CORS_ORIGINS="*"
# When true, log every incoming request and its response (method, body, status,
# duration). Handy for debugging the app<->backend wiring; turn off in prod.
LOG_REQUESTS=false

# --- Auth ---
# Use a long random string in production.
JWT_SECRET="dev-pitstop-change-me"
# Access token lifetime in seconds (15 min).
JWT_ACCESS_TTL=900
# Refresh token lifetime in days.
JWT_REFRESH_TTL_DAYS=30

# --- OTP ---
# Lifetime of an OTP code in seconds (5 min).
OTP_TTL=300
# When true, the OTP is returned in the API response (demo only — never in prod).
OTP_EXPOSE_DEV_CODE=true

# --- Firebase (phone auth) ---
# Path to the Firebase service-account JSON, used to verify ID tokens from the
# app's phone sign-in. Leave unset to disable the /auth/firebase route. Keep the
# file out of git. Example: FIREBASE_CREDENTIALS_FILE="./secrets/firebase-service-account.json"
FIREBASE_CREDENTIALS_FILE=

# --- Shop ---
# The shop a brand-new customer is attached to on first sign-in.
DEFAULT_SHOP_ID="shop_pitstop_hsr"
