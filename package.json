{
  "name": "pitstop-backend",
  "version": "0.1.0",
  "description": "PitStop car-wash & detailing backend (NestJS + Prisma + PostgreSQL)",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed-lifecycle": "ts-node --transpile-only prisma/seed-lifecycle.ts",
    "db:reset": "prisma migrate reset --force",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts && ts-node --transpile-only prisma/seed-lifecycle.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^6.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^14.0.0",
    "luxon": "^3.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@swc/core": "^1.15.43",
    "@types/express": "^4.17.25",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "fast-check": "^4.9.0",
    "prisma": "^6.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
